# Copy to .env and replace the placeholders. Never commit a real .env.
# With DEBUG on, a placeholder or empty key is replaced by a random key kept in the git-ignored
# backend/.dev_secret_key. With DEBUG off the app refuses to start without a real one.
SECRET_KEY=replace-with-a-long-random-string
# Local dev only. With DEBUG off (the default) SECRET_KEY must be a real secret.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Base URL of the SPA; used in invite and email-verification links.
FRONTEND_URL=http://localhost:5173

CELERY_BROKER_URL=redis://valkey:6379/0
# Django cache (allauth and invite rate limits).
CACHE_URL=redis://valkey:6379/1

# Used only when DEBUG is False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

# Lab file storage (ARCHITECTURE section 8). Dev writes to the labfiles Docker volume.
# For production set LAB_FILES_BUCKET (S3-compatible); AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# come from the environment. LAB_FILES_ENDPOINT_URL is for non-AWS providers.
LAB_FILES_ROOT=/data/lab_files
LAB_FILES_BUCKET=
LAB_FILES_ENDPOINT_URL=
LAB_FILES_REGION=
