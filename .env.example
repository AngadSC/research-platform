# Copy to .env and replace the placeholders. Never commit a real .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Base URL of the SPA; used in invite and email-verification links.
FRONTEND_URL=http://localhost:5173

CELERY_BROKER_URL=redis://valkey:6379/0

# Used only when DEBUG is False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
