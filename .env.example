# Copy to .env and replace the placeholders. Never commit a real .env.
# With DEBUG on, a placeholder or empty key is replaced by a random key kept in the git-ignored
# backend/.dev_secret_key. With DEBUG off the app refuses to start without a real one.
SECRET_KEY=replace-with-a-long-random-string
# Local dev only. With DEBUG off (the default) SECRET_KEY must be a real secret.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Base URL of the SPA; used in invite and email-verification links.
FRONTEND_URL=http://localhost:5173

CELERY_BROKER_URL=redis://valkey:6379/0
# Django cache (allauth and invite rate limits).
CACHE_URL=redis://valkey:6379/1

# Used only when DEBUG is False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

# Lab file storage (ARCHITECTURE section 8). Dev writes to the labfiles Docker volume.
# For production set LAB_FILES_BUCKET (S3-compatible); AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# come from the environment. LAB_FILES_ENDPOINT_URL is for non-AWS providers.
LAB_FILES_ROOT=/data/lab_files
LAB_FILES_BUCKET=
LAB_FILES_ENDPOINT_URL=
LAB_FILES_REGION=

# Outbound email (core/email.py). Unset means the console backend in dev.
# EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
# EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
# DEFAULT_FROM_EMAIL=Research Workspace <noreply@example.org>
# POSTMARK_SERVER_TOKEN=
# AWS_SES_REGION_NAME=eu-west-1   # SES credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Google sign-in (openid, email, profile). Leave empty to hide the Google button.
# Authorized redirect URI in Google Cloud: http://localhost:5173/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrations (ARCHITECTURE section 9, D63, D66). Fernet keys, newest first, comma-separated;
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty with DEBUG on: a random dev key kept in the git-ignored backend/.dev_integration_key.
INTEGRATION_ENCRYPTION_KEYS=
# Google Drive integration OAuth client (separate from sign-in). Redirect URI to register:
# http://localhost:5173/api/integrations/oauth/callback/
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Google Picker (public by design): browser API key restricted to your origin, and the Cloud
# project number (the "app id"; drive.file grants apply to the picked file only with it).
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=

# File storage providers: OneDrive and SharePoint, Dropbox, Box (D100 to D104). Each is hidden
# until its client id is set. Redirect URI to register on every one:
# http://localhost:5173/api/integrations/oauth/callback/
INTEGRATION_ONEDRIVE_CLIENT_ID=
INTEGRATION_ONEDRIVE_CLIENT_SECRET=
# Microsoft tenant: common (default), organizations, consumers, a tenant id or a domain.
INTEGRATION_ONEDRIVE_TENANT=common
INTEGRATION_DROPBOX_CLIENT_ID=
INTEGRATION_DROPBOX_CLIENT_SECRET=
INTEGRATION_BOX_CLIENT_ID=
INTEGRATION_BOX_CLIENT_SECRET=

# Code and writing providers: GitHub, GitLab, Overleaf (D105 to D109). No client id or secret:
# GitHub and GitLab take a personal access token the person pastes; Overleaf is link-only.
# For GitLab, optionally restrict which servers may be connected (exact hosts or *.domain),
# for example INTEGRATION_ALLOWED_INSTANCE_HOSTS=gitlab.com,git.myuniversity.edu
# (empty allows any public https host; the SSRF checks always apply). Shared with REDCap.
