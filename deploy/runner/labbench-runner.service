# The analysis runner (VISION C2) on its own server. Install: docs/DEPLOY.md, "13. Analysis runner".
[Unit]
Description=labbenchos analysis runner
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=labrunner
Group=labrunner
SupplementaryGroups=docker
EnvironmentFile=/etc/labbench-runner.env
ExecStart=/usr/bin/python3 /opt/labbench-runner/server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
