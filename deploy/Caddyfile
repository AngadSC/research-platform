# Production reverse proxy (docs/DEPLOY.md). The domain comes from SITE_DOMAIN in deploy/.env (read by
# docker compose). Caddy gets and renews the TLS certificate itself once DNS points at this server
# and ports 80 and 443 are open.
{$SITE_DOMAIN} {
	encode zstd gzip

	# D53 (docs/DECISIONS.md): stop oversized bodies before gunicorn. The app allows
	# ATTACHMENT_MAX_BYTES (50 MiB, backend/config/settings.py) plus MULTIPART_ALLOWANCE (64 KiB,
	# backend/core/middleware.py) for multipart framing, so the proxy uses the same total.
	request_body {
		max_size 52494336
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# API, allauth headless, provider callbacks and the health probe go to gunicorn.
	# No /admin route: the Django admin is mounted only when DEBUG is on (D41).
	# /mcp and /.well-known/* (OAuth metadata) are the MCP server for AI apps (D161).
	# D190: the in-app assistant streams its answer as server-sent events. Flush every write at
	# once (no buffering) and allow a long response; gunicorn runs gthread workers with a 330 s
	# timeout (docker-compose.prod.yml). This must come before the general @backend handler.
	# D196: the app stops every stream after 300 s (ASSISTANT_STREAM_DEADLINE), so the 330 s
	# timeouts below are only a backstop; keep them above the deadline, and keep the number of
	# concurrent streams (ASSISTANT_MAX_STREAMS) well below gunicorn's workers x threads.
	@assistant_stream path_regexp ^/api/labs/[^/]+/assistant/conversations/[^/]+/(messages|approvals)/$
	handle @assistant_stream {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 330s
				read_timeout 330s
			}
		}
	}

	@backend path /api/* /_allauth/* /accounts/* /healthz /mcp /.well-known/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the React SPA, built by frontend/Dockerfile.prod into /srv.
	# Unknown paths fall back to index.html so client-side routes survive a reload.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# D90/D91: downloads redirect to a presigned bucket URL and the PDF viewer fetch()es it, so
		# connect-src names the bucket origin (replace BUCKET.s3.REGION.amazonaws.com with your
		# endpoint; docs/DEPLOY.md has the bucket CORS rule).
		# Google Picker (Drive integration) and Google sign-in.
		# form-action needs accounts.google.com because the sign-in form POST redirects there.
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com/js/api.js https://apis.google.com/_/scs/ https://www.gstatic.com/_/; frame-src https://content.googleapis.com https://docs.google.com https://drive.google.com https://accounts.google.com; connect-src 'self' https://BUCKET.s3.REGION.amazonaws.com https://content.googleapis.com https://apis.google.com https://docs.google.com https://drive.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://ssl.gstatic.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'"
	}
}
