# Production environment for deploy/docker-compose.prod.yml. Copy to deploy/.env.prod on the server
# and replace every replace-with-* value. Never commit the real file. docs/DEPLOY.md explains each
# value and how to generate the secrets.

# --- Django core ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-random-secret-64-chars-or-more
DEBUG=False
ALLOWED_HOSTS=replace-with-your-domain
# Origin of the site, used in invite and verification links and for CSRF origin checks.
FRONTEND_URL=https://replace-with-your-domain
CSRF_TRUSTED_ORIGINS=https://replace-with-your-domain
# Caddy is the only proxy in front of gunicorn.
TRUSTED_PROXY_COUNT=1

# --- PostgreSQL 16 (the compose postgres service reads the same variables) ---
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Valkey (Redis protocol). Password required. ---
# Plain redis:// is fine on the private compose network. Use rediss:// (TLS) and a TLS-enabled
# Valkey if the broker ever crosses a network you do not control. See docs/DEPLOY.md.
VALKEY_PASSWORD=replace-with-valkey-password
CELERY_BROKER_URL=redis://:replace-with-valkey-password@valkey:6379/0
CACHE_URL=redis://:replace-with-valkey-password@valkey:6379/1

# --- Cookies and HTTPS (Caddy terminates TLS) ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False

# --- Integration token encryption (D63). Fernet keys, newest first, comma-separated. ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEYS=replace-with-fernet-key

# --- Lab files bucket (S3-compatible, private; D26) ---
LAB_FILES_BUCKET=replace-with-bucket-name
LAB_FILES_REGION=replace-with-region
# Leave empty for AWS S3. Set for other S3-compatible providers.
LAB_FILES_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

# --- Email (pick one provider block; see docs/DEPLOY.md) ---
DEFAULT_FROM_EMAIL=labbenchos <noreply@replace-with-your-domain>
# Postmark:
EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
POSTMARK_SERVER_TOKEN=replace-with-postmark-server-token
# Amazon SES (use these instead of the Postmark lines; SES uses the AWS_* keys above):
# EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
# AWS_SES_REGION_NAME=replace-with-region

# --- Google sign-in (openid, email, profile) ---
# Redirect URI to register: https://replace-with-your-domain/accounts/google/login/callback/
GOOGLE_CLIENT_ID=replace-with-sign-in-client-id
GOOGLE_CLIENT_SECRET=replace-with-sign-in-client-secret

# --- Google Drive integration (separate OAuth client, D66) ---
# Redirect URI to register: https://replace-with-your-domain/api/integrations/oauth/callback/
GOOGLE_DRIVE_CLIENT_ID=replace-with-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-drive-client-secret
# Google Picker: browser API key (restricted to your domain) and Cloud project number.
GOOGLE_DRIVE_API_KEY=replace-with-picker-api-key
GOOGLE_DRIVE_APP_ID=replace-with-cloud-project-number

# --- File storage providers: OneDrive and SharePoint, Dropbox, Box (D100 to D104) ---
# Redirect URI to register on each: https://replace-with-your-domain/api/integrations/oauth/callback/
INTEGRATION_ONEDRIVE_CLIENT_ID=replace-with-onedrive-client-id
INTEGRATION_ONEDRIVE_CLIENT_SECRET=replace-with-onedrive-client-secret
# common (default), organizations, consumers, a tenant id or a domain
INTEGRATION_ONEDRIVE_TENANT=common
INTEGRATION_DROPBOX_CLIENT_ID=replace-with-dropbox-app-key
INTEGRATION_DROPBOX_CLIENT_SECRET=replace-with-dropbox-app-secret
INTEGRATION_BOX_CLIENT_ID=replace-with-box-client-id
INTEGRATION_BOX_CLIENT_SECRET=replace-with-box-client-secret

# --- Code and writing providers: GitHub, GitLab, Overleaf (D105 to D109) ---
# No client credentials: people paste a personal access token (GitHub fine-grained, GitLab
# read_api). Name the GitLab servers that may be connected (and REDCap's); exact hosts or *.domain.
# INTEGRATION_ALLOWED_INSTANCE_HOSTS=gitlab.com,git.replace-with-your-university.edu
