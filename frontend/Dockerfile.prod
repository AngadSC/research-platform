# Production build of the SPA. The result is static files served by Caddy (deploy/Caddyfile).
# Build: docker build -f frontend/Dockerfile.prod frontend

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
