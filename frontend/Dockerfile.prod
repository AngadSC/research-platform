# Production build of the SPA. The result is static files served by Caddy (deploy/Caddyfile).
# Build: docker build -f frontend/Dockerfile.prod frontend

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
# The statistics engine's Python runtime, served from /pyodide/ (checks every file's sha256).
# Before COPY . . so the download is cached until the lockfile or the script changes.
COPY scripts/fetch-pyodide.mjs scripts/
RUN npm run pyodide:fetch
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
